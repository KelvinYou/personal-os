# COROS watch credentials (used by scripts/sync_coros.py)
# Copy this file to .env and fill in your values. .env is gitignored.
COROS_EMAIL=you@example.com
COROS_PASSWORD=your-password
COROS_REGION=us  # us=全球(teamapi), eu=欧洲, asia/cn=中国大陆; 马来西亚选 us

# Google Calendar sync (used by scripts/sync_calendar.py)
# OAuth client json + cached token live in .credentials/ (gitignored), not here — see
# scripts/lib/gcal.py docstring for the one-time setup steps.
GOOGLE_CALENDAR_ID=primary  # or a specific calendar's ID from Google Calendar settings
