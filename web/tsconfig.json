{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-3d-standard/types/**/*.ts",
    ".next-browser-3027/types/**/*.ts",
    ".next-browser-3031/types/**/*.ts",
    ".next-browser-3032/types/**/*.ts",
    ".next-browser-3040/types/**/*.ts",
    ".next-browser-3067/types/**/*.ts",
    ".next-browser-3069/types/**/*.ts",
    ".next-browser-3071/types/**/*.ts",
    ".next-browser-3073/types/**/*.ts",
    ".next-browser-tests/types/**/*.ts",
    ".next-collaboration-review/types/**/*.ts",
    ".next-diag/types/**/*.ts",
    ".next-home-design/types/**/*.ts",
    ".next-home-edit/types/**/*.ts",
    ".next-home-interactions/types/**/*.ts",
    ".next-home-realism/types/**/*.ts",
    ".next-home-walk/types/**/*.ts",
    ".next-office-character-final/types/**/*.ts",
    ".next-office-character-production/types/**/*.ts",
    ".next-office-character-review/types/**/*.ts",
    ".next-office-courtyard-final/types/**/*.ts",
    ".next-office-courtyard-production/types/**/*.ts",
    ".next-office-courtyard/types/**/*.ts",
    ".next-office-direct/types/**/*.ts",
    ".next-office-garden-production/types/**/*.ts",
    ".next-office-garden-review/types/**/*.ts",
    ".next-office-player/types/**/*.ts",
    ".next-office-review/types/**/*.ts",
    ".next-office-team/types/**/*.ts",
    ".next-office-workbench/types/**/*.ts",
    ".next-posts/types/**/*.ts",
    ".next-skill-employees/types/**/*.ts",
    ".next-verify-3041/types/**/*.ts",
    ".next-verify-3043/types/**/*.ts",
    ".next-verify-3045/types/**/*.ts",
    ".next-verify-3047/types/**/*.ts",
    ".next-verify-3051/types/**/*.ts",
    ".next-verify-3053/types/**/*.ts",
    ".next-verify-3061/types/**/*.ts",
